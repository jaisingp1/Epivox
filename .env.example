# ==============================================================================
# CONFIGURACIÓN DE ENTORNO EPIVOX (.env)
# ==============================================================================
# Copia este archivo a `.env` tanto en desarrollo local como en tu VPS:
# cp .env.example .env
# ==============================================================================

# Entorno de ejecución:
# - 'development' -> Modo local con hot-reload y datos demo de prueba
# - 'production'  -> Modo servidor en vivo (epivox.pastenlabs.com)
NODE_ENV=development
APP_ENV=development

# ¿Cargar preguntas y presentaciones mockup al regenerar la base de datos?
# - true  -> (Desarrollo) Carga las 3 actividades de demostración (Cultura, LOTO, Sondeo)
# - false -> (Producción) Base de datos limpia sin preguntas de prueba (solo admin y temas)
SEED_MOCK_DATA=true

# Puerto del servidor Express y WebSockets
PORT=3000

# Secreto criptográfico para firma de tokens JWT de sesión
# ⚠️ IMPORTANTE: Genera una clave aleatoria segura en producción
JWT_SECRET=epivox_secret_token_jwt_stand_alone_change_in_production_2026

# Dominio público para generar enlaces de invitación y restablecimiento
# Local: http://localhost:5173
# VPS:   https://epivox.pastenlabs.com
PUBLIC_URL=http://localhost:5173
